@CodeNexus.API_HostAddress = http://localhost:5063

GET {{CodeNexus.API_HostAddress}}/weatherforecast/
Accept: application/json

###

# Subject API Tests

# Get all subjects (no filter)
GET {{CodeNexus.API_HostAddress}}/api/subjects
Accept: application/json
Authorization: Bearer YOUR_JWT_TOKEN_HERE

###

# Get subjects filtered by Frontend category
GET {{CodeNexus.API_HostAddress}}/api/subjects?category=0
Accept: application/json
Authorization: Bearer YOUR_JWT_TOKEN_HERE

###

# Get subjects filtered by Backend category
GET {{CodeNexus.API_HostAddress}}/api/subjects?category=1
Accept: application/json
Authorization: Bearer YOUR_JWT_TOKEN_HERE

###

# Get subjects filtered by Database category
GET {{CodeNexus.API_HostAddress}}/api/subjects?category=2
Accept: application/json
Authorization: Bearer YOUR_JWT_TOKEN_HERE

###

# Get subjects filtered by Mobile category
GET {{CodeNexus.API_HostAddress}}/api/subjects?category=3
Accept: application/json
Authorization: Bearer YOUR_JWT_TOKEN_HERE

###

# Get subjects filtered by Other category
GET {{CodeNexus.API_HostAddress}}/api/subjects?category=9
Accept: application/json
Authorization: Bearer YOUR_JWT_TOKEN_HERE

###

# Create a new subject with Frontend category
POST {{CodeNexus.API_HostAddress}}/api/subjects
Content-Type: application/json
Authorization: Bearer YOUR_JWT_TOKEN_HERE

{
  "name": "React Development",
  "description": "Learn React.js for frontend development",
  "color": "#61DAFB",
  "icon": "react-icon",
  "category": 0
}

###

# Create a new subject with Backend category
POST {{CodeNexus.API_HostAddress}}/api/subjects
Content-Type: application/json
Authorization: Bearer YOUR_JWT_TOKEN_HERE

{
  "name": "Node.js Development",
  "description": "Learn Node.js for backend development",
  "color": "#339933",
  "icon": "nodejs-icon",
  "category": 1
}

###

# Create a new subject with Database category
POST {{CodeNexus.API_HostAddress}}/api/subjects
Content-Type: application/json
Authorization: Bearer YOUR_JWT_TOKEN_HERE

{
  "name": "SQL Fundamentals",
  "description": "Learn SQL for database management",
  "color": "#336791",
  "icon": "sql-icon",
  "category": 2
}

###

# Focus Session API Tests

# Complete session with Progress submission (no validation required)
POST {{CodeNexus.API_HostAddress}}/api/focus-sessions/{{sessionId}}/complete-json
Content-Type: application/json
Authorization: Bearer YOUR_JWT_TOKEN_HERE

{
  "submittedCode": "// Work in progress...\nconsole.log('Still working on this');",
  "submittedSummary": null,
  "isEarlyCompletion": false,
  "submissionType": 0
}

###

# Complete session with Review submission (requires code/summary, runs verification)
POST {{CodeNexus.API_HostAddress}}/api/focus-sessions/{{sessionId}}/complete-json
Content-Type: application/json
Authorization: Bearer YOUR_JWT_TOKEN_HERE

{
  "submittedCode": "function fibonacci(n) {\n  if (n <= 1) return n;\n  return fibonacci(n-1) + fibonacci(n-2);\n}",
  "submittedSummary": null,
  "isEarlyCompletion": false,
  "submissionType": 2
}

###

# Complete session with Final submission (requires code/summary, runs verification, completes task if passed)
POST {{CodeNexus.API_HostAddress}}/api/focus-sessions/{{sessionId}}/complete-json
Content-Type: application/json
Authorization: Bearer YOUR_JWT_TOKEN_HERE

{
  "submittedCode": "function fibonacci(n) {\n  if (n <= 1) return n;\n  return fibonacci(n-1) + fibonacci(n-2);\n}\n\n// Test cases\nconsole.log(fibonacci(5)); // Should output 5\nconsole.log(fibonacci(10)); // Should output 55",
  "submittedSummary": null,
  "isEarlyCompletion": false,
  "submissionType": 1
}

###

# Complete session with Form data (for file uploads)
POST {{CodeNexus.API_HostAddress}}/api/focus-sessions/{{sessionId}}/complete
Content-Type: multipart/form-data
Authorization: Bearer YOUR_JWT_TOKEN_HERE

submittedCode=console.log('Hello World');
submittedSummary=
isEarlyCompletion=false
submissionType=0

###
