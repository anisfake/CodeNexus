# Subject API Tests

# Get all subjects (no filter)
GET {{CodeNexus.API_HostAddress}}/api/subjects
Accept: application/json
Authorization: Bearer YOUR_JWT_TOKEN_HERE

###

# Get subjects filtered by Frontend category
GET {{CodeNexus.API_HostAddress}}/api/subjects?category=0
Accept: application/json
Authorization: Bearer YOUR_JWT_TOKEN_HERE

###

# Get subjects filtered by Backend category
GET {{CodeNexus.API_HostAddress}}/api/subjects?category=1
Accept: application/json
Authorization: Bearer YOUR_JWT_TOKEN_HERE

###

# Get subjects filtered by Database category
GET {{CodeNexus.API_HostAddress}}/api/subjects?category=2
Accept: application/json
Authorization: Bearer YOUR_JWT_TOKEN_HERE

###

# Get subjects filtered by Mobile category
GET {{CodeNexus.API_HostAddress}}/api/subjects?category=3
